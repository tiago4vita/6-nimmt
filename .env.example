# Docker Compose environment presets
#
# Local (solo dev on this machine):
#   docker compose --env-file .env.local up --build
#
# LAN (play with a friend on the same Wi‑Fi):
#   docker compose --env-file .env.lan up --build
#
# Update LAN_HOST in .env.lan if your PC's IPv4 address changes.

LAN_HOST=192.168.1.11
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
VITE_GRAPHQL_HTTP_URL=http://localhost:8000/graphql
VITE_GRAPHQL_WS_URL=ws://localhost:8000/graphql
