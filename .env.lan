# LAN play — everyone (including you) opens http://192.168.1.11:5173
# Usage: docker compose --env-file .env.lan up --build
#
# If your PC gets a new IPv4 address, update LAN_HOST and re-run compose.

LAN_HOST=192.168.1.11
FRONTEND_ORIGIN=http://192.168.1.11:5173
CORS_ORIGINS=http://localhost:5173,http://192.168.1.11:5173
VITE_GRAPHQL_HTTP_URL=http://192.168.1.11:8000/graphql
VITE_GRAPHQL_WS_URL=ws://192.168.1.11:8000/graphql
